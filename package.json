{
  "name": "bowcode",
  "version": "1.39.8",
  "productName": "Bowcode",
  "description": "Self-hosted remote web UI for Claude Code, Codex and OpenCode",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "bowcode": "dist-server/server/modules/cli/cli.js"
  },
  "files": [
    "shared/",
    "public/api-docs.html",
    "dist/",
    "dist-server/",
    "scripts/",
    "install.sh",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "homepage": "https://github.com/50xu/bowcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/50xu/bowcode.git"
  },
  "bugs": {
    "url": "https://github.com/50xu/bowcode/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "preserver": "node scripts/promote-dist-server.mjs recover",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server.next', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "postbuild:server": "node scripts/promote-dist-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --tsconfig server/tsconfig.json --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "test:client": "vitest run",
    "lint": "oxlint src/ server/",
    "lint:server": "oxlint server/",
    "lint:client": "oxlint src/",
    "lint:fix": "oxlint src/ server/ --fix",
    "start": "npm run build && npm run server",
    "release": "node scripts/release/cut-release.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js",
    "prepare": "husky",
    "update:platform": "./update-platform.sh"
  },
  "keywords": [
    "claude code",
    "claude-code",
    "bowcode",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "Bowcode contributors",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@iarna/toml": "^2.2.5",
    "@octokit/rest": "^22.0.1",
    "@openai/codex": "0.167.2",
    "@openai/codex-sdk": "^0.167.2",
    "@opencode/client": "2.2.7",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.12",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "croner": "^11.0.0",
    "cross-spawn": "^7.0.3",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.7.1",
    "ignore": "^7.0.14",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "mermaid": "^12.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "node-pty": "^1.2.0-beta.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-scan": "^0.5.7",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "auto-changelog": "^2.7.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "node-gyp": "^13.1.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "oxlint",
    "server/**/*.{js,ts}": "oxlint"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.8"
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3": true,
    "esbuild": true,
    "node-pty": true,
    "unrs-resolver": true
  }
}
